<?xml version="1.0"?>
<package format="3">
    <name>assistant_mission</name>
    <version>0.1.0</version>
    <description>PAL demo of an assistant robot, integrating the latest developments in HRI and navigation.</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <!-- Example:  -->
  <!-- <maintainer email="jane.doe@example.com">Jane Doe</maintainer> -->
  <maintainer email="todo@todo.todo">TODO</maintainer>

  <!-- One license tag required, multiple allowed, one license per tag -->
  <!-- Commonly used license strings: -->
  <!--   BSD, MIT, Boost Software License, GPLv2, GPLv3, LGPLv2.1, LGPLv3 -->
  <license>Apache-2.0</license>

  <!-- The *depend tags are used to specify dependencies -->
  <!-- Dependencies can be catkin packages or system dependencies -->
  <depend>rclpy</depend>
  <depend>lifecycle_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>launch_pal</depend>
  <depend>hri_actions_msgs</depend>
  <depend>pyhri</depend>


  <!-- tasks/skills actions definitions -->

  <depend>unique_identifier_msgs</depend>
  <depend>kb_msgs</depend>
  <depend>communication_skills</depend>
  <depend>interaction_skills</depend>
  <depend>navigation_skills</depend>
  <depend>semantic_state_msgs</depend>
  <depend>explainability_msgs</depend>

  <!-- ensure the tasks and skills we need are also installed -->
  <!-- <exec_depend>say_skill</exec_depend> -->
  <!-- <exec_depend>skill_ask_human_to_pick</exec_depend>
  <exec_depend>skill_ask_human_to_place</exec_depend> -->
  <!-- <exec_depend>skill_look_for</exec_depend> -->
  <exec_depend>skill_ask_human_for_help</exec_depend>
  <exec_depend>skill_navigate_to_zone</exec_depend>
  <exec_depend>skill_explain</exec_depend>
  <exec_depend>communication_hub</exec_depend>
  <exec_depend>semantic_state_aggregator</exec_depend>
  <exec_depend>chatbot_ollama</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
      <build_type>ament_python</build_type>

      <mission content-type="json">
       {
         "name": "assistant_mission",
         "description": "This example mission controller implements a simple, LLM-based dialogue system.",
         "dependencies": {
             "skills": ["say","skill_ask_human_for_help","skill_navigate_to_zone"]
         }
       }
      </mission>
  </export>
</package>